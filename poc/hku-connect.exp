#!/usr/bin/expect -f
set timeout -1
set password $env(HKU_PASSWORD)

spawn openconnect vpn2fa.hku.hk \
    --user=runqiuhu@connect.hku.hk \
    --useragent=AnyConnect \
    --servercert pin-sha256:rcPRg32fisaTgAORYP54vNkckUqcs/18f5Wm/miuX4M= \
    --no-external-auth

expect "Password:"
send "$password\r"

expect "Response:"
interact
